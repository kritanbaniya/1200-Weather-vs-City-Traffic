MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=weather
MYSQL_PASSWORD=weather
MYSQL_DATABASE=weather_traffic

# Inclusive dates. October includes the week cleaned in api_test.ipynb
# and earlier rain days, including 11 October.
START_DATE=2026-10-01
